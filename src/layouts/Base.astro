---
const { title = 'VisaWise', description = 'Free Schengen visa readiness check for Indian travellers: document checklist, red flags and your application timeline.' } = Astro.props;
const pageTitle = title === 'VisaWise' ? title : `${title} · VisaWise`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap row">
        <a href="/" class="logo"><span class="dot" aria-hidden="true"></span>VisaWise</a>
        <nav><a href="/check">Check my visa</a></nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>VisaWise is a free, independent guide. It is not affiliated with any embassy, consulate, visa centre or government. Rules are based on official public sources, shown next to each check; consulates may ask for more. It cannot guarantee a visa.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Vibrant travel palette: indigo, pink, cyan, amber, green. */
  :root {
    --bg: #f6f5ff; --surface: #ffffff; --surface-2: #f0eefe; --text: #17153a; --muted: #5d5a7a;
    --border: #e2def8; --accent: #5b3df5; --accent-ink: #ffffff; --accent-soft: #ebe6ff;
    --pink: #e8336f; --pink-soft: #ffe4ee; --cyan: #0891b2; --cyan-soft: #d9f6fd;
    --amber: #c2410c; --amber-soft: #fff0d6; --green: #0f9d58; --green-soft: #dcf7e8;
    --warn: #b45309; --warn-soft: #fff0d6; --fail: #d92d4b; --fail-soft: #ffe4ea; --pass: #0f9d58; --pass-soft: #dcf7e8;
    --grad: linear-gradient(120deg, #5b3df5 0%, #b23cf0 40%, #ff4d8d 70%, #ffa53b 100%);
    --radius: 16px; --shadow: 0 1px 2px rgb(40 20 120 / .06), 0 8px 24px rgb(40 20 120 / .07);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #100e24; --surface: #1a1736; --surface-2: #231f45; --text: #f0eeff; --muted: #aaa6cf;
      --border: #332e5e; --accent: #9b87ff; --accent-ink: #120a3a; --accent-soft: #2c2463;
      --pink: #ff7aa8; --pink-soft: #45163a; --cyan: #4fd6f0; --cyan-soft: #0f3644; --amber: #ffb35c; --amber-soft: #42290f;
      --green: #4ee39a; --green-soft: #0f3a29;
      --warn: #ffb35c; --warn-soft: #42290f; --fail: #ff6f87; --fail-soft: #4a1524; --pass: #4ee39a; --pass-soft: #0f3a29;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #100e24; --surface: #1a1736; --surface-2: #231f45; --text: #f0eeff; --muted: #aaa6cf;
    --border: #332e5e; --accent: #9b87ff; --accent-ink: #120a3a; --accent-soft: #2c2463;
    --pink: #ff7aa8; --pink-soft: #45163a; --cyan: #4fd6f0; --cyan-soft: #0f3644; --amber: #ffb35c; --amber-soft: #42290f;
    --green: #4ee39a; --green-soft: #0f3a29;
    --warn: #ffb35c; --warn-soft: #42290f; --fail: #ff6f87; --fail-soft: #4a1524; --pass: #4ee39a; --pass-soft: #0f3a29;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 .5em; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.7rem); letter-spacing: -.02em; }
  h2 { font-size: 1.35rem; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .site-header { border-bottom: 1px solid var(--border); background: var(--grad) top / 100% 4px no-repeat, var(--surface); }
  .site-header .row { height: 64px; padding-top: 4px; }
  .site-header nav a { color: var(--accent); text-decoration: none; font-weight: 650; font-size: .95rem; background: var(--accent-soft); padding: 7px 14px; border-radius: 99px; }
  .logo { font-weight: 800; font-size: 1.2rem; color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 8px; }
  .logo .dot { width: 16px; height: 16px; border-radius: 50%; background: var(--grad); box-shadow: 0 0 0 4px var(--accent-soft); }
  main.wrap { padding-top: 32px; padding-bottom: 48px; }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: .85rem; padding: 20px 0 32px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); }
  .muted { color: var(--muted); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer;
    background: linear-gradient(110deg, #5b3df5, #c0267a); color: #fff; font: inherit; font-weight: 700;
    padding: 12px 20px; border-radius: 12px; text-decoration: none; box-shadow: 0 6px 18px rgb(91 61 245 / .28);
  }
  .btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .btn.secondary { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
  .btn:disabled { opacity: .6; cursor: progress; }
  input[type=text], input[type=url], input[type=number], input[type=date], select {
    width: 100%; font: inherit; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px; padding: 11px 12px;
  }
  input:focus-visible, select:focus-visible, .btn:focus-visible { outline: 3px solid var(--accent-soft); outline-offset: 1px; border-color: var(--accent); }
  label.field { display: block; font-weight: 600; margin-bottom: 14px; }
  label.field > span.hint { display: block; font-weight: 400; color: var(--muted); font-size: .88rem; margin: 2px 0 6px; }
</style>
